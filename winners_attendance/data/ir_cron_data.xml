<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron pour la génération quotidienne automatique à 23:05 UTC (00:05 en Algérie) -->
        <record id="cron_generate_daily_attendance_sheets" model="ir.cron">
            <field name="name">Attendance: Génération automatique quotidienne des feuilles</field>
            <field name="model_id" ref="model_winners_attendance_sheet"/>
            <field name="state">code</field>
            <field name="code">model._generate_daily_sheets()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <!-- S'exécute tous les jours à 23:05 UTC -->
            <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=5, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron léger s'exécutant toutes les 5 minutes pour mettre à jour les états des feuilles (en cours / clôturer automatiquement) -->
        <record id="cron_update_attendance_sheet_states" model="ir.cron">
            <field name="name">Attendance: Mise à jour automatique des états des feuilles</field>
            <field name="model_id" ref="model_winners_attendance_sheet"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_sheet_states()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron pour la synchronisation des pointages ZKTeco toutes les 5 minutes -->
        <record id="cron_sync_zkteco" model="ir.cron">
            <field name="name">Attendance: Synchronisation ZKTeco</field>
            <field name="model_id" ref="model_winners_attendance_processor"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_zkteco()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
