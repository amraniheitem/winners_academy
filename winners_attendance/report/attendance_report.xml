<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_attendance_sheet_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 12px; color: #333; padding: 15mm 10mm;">

                        <!-- ======== EN-TÊTE ======== -->
                        <div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid #1a237e; padding-bottom: 10px;">
                            <h1 style="color: #1a237e; font-size: 22px; font-weight: 700; margin: 0; letter-spacing: 2px;">
                                WINNERS ACADEMY
                            </h1>
                            <h2 style="color: #424242; font-size: 15px; font-weight: 600; margin: 4px 0 0 0; letter-spacing: 1px; text-transform: uppercase;">
                                FEUILLE DE PRÉSENCE
                            </h2>
                        </div>

                        <!-- ======== INFORMATIONS DU CRÉNEAU ======== -->
                        <table style="width: 100%; margin-bottom: 18px; border-collapse: collapse; font-size: 11px;">
                            <tr>
                                <td style="width: 18%; padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Groupe / Cours :</strong>
                                </td>
                                <td style="width: 32%; padding: 6px 8px; border: 1px solid #bdbdbd; font-size: 12px; font-weight: bold; color: #1a237e;">
                                    <span t-field="o.group_id.name"/>
                                </td>
                                <td style="width: 18%; padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Date de la séance :</strong>
                                </td>
                                <td style="width: 32%; padding: 6px 8px; border: 1px solid #bdbdbd; font-size: 12px; font-weight: bold;">
                                    <span t-field="o.date" t-options="{'widget': 'date'}"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Enseignant :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd;">
                                    <span t-field="o.teacher_id.name"/>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Horaire :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd;">
                                    <span t-field="o.time_start" t-options="{'widget': 'float_time'}"/>
                                    à
                                    <span t-field="o.time_end" t-options="{'widget': 'float_time'}"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Matière :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd;">
                                    <t t-if="o.subject">
                                        <span t-esc="dict(o.group_id._fields['subject'].selection).get(o.subject, '')"/>
                                    </t>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Salle :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; font-weight: bold;">
                                    <span t-field="o.room_id.name"/>
                                    <t t-if="o.branch_id">
                                        (<span t-field="o.branch_id.name"/>)
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Statut feuille :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd;">
                                    <span t-esc="dict(o._fields['state'].selection).get(o.state, '')"/>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; background-color: #f5f5f5;">
                                    <strong>Présents / Inscrits :</strong>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #bdbdbd; font-weight: bold; color: #2e7d32;">
                                    <span t-esc="o.progress_display"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ======== TABLEAU DES ÉTUDIANTS ======== -->
                        <h3 style="color: #1a237e; font-size: 13px; border-bottom: 2px solid #c5cae9; padding-bottom: 4px; margin: 15px 0 8px 0;">
                            Liste des étudiants inscrits
                        </h3>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 11px;">
                            <thead>
                                <tr style="background-color: #1a237e; color: white;">
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: center; width: 6%;">N°</th>
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: left; width: 34%;">Nom &amp; Prénom de l'étudiant</th>
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: center; width: 15%;">Pointeuse (UID)</th>
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: center; width: 15%;">Statut</th>
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: center; width: 15%;">Heure pointage</th>
                                    <th style="padding: 6px 8px; border: 1px solid #1a237e; text-align: center; width: 15%;">Émargement / Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not o.line_ids">
                                    <tr>
                                        <td colspan="6" style="padding: 12px; text-align: center; color: #757575; border: 1px solid #bdbdbd; font-style: italic;">
                                            Aucun étudiant n'est encore inscrit dans cette feuille de présence.
                                        </td>
                                    </tr>
                                </t>
                                <t t-set="idx" t-value="1"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr style="border-bottom: 1px solid #bdbdbd;">
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; text-align: center; font-weight: bold;">
                                            <span t-esc="idx"/>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; font-weight: 600;">
                                            <span t-esc="'%s %s' % (line.student_id.first_name or '', line.student_id.name or '')"/>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; text-align: center;">
                                            <t t-if="line.student_id.zk_device_id">
                                                UID <span t-field="line.student_id.zk_device_id"/>
                                            </t>
                                            <t t-else="">
                                                <span style="color: #9e9e9e;">—</span>
                                            </t>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; text-align: center;">
                                            <t t-if="line.status == 'present'">
                                                <span style="color: #2e7d32; font-weight: bold; background-color: #e8f5e9; padding: 2px 6px; border-radius: 3px;">Présent</span>
                                            </t>
                                            <t t-elif="line.status == 'late'">
                                                <span style="color: #f57c00; font-weight: bold; background-color: #fff3e0; padding: 2px 6px; border-radius: 3px;">En Retard</span>
                                            </t>
                                            <t t-else="">
                                                <span style="color: #c62828; font-weight: bold; background-color: #ffebee; padding: 2px 6px; border-radius: 3px;">Absent</span>
                                            </t>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; text-align: center;">
                                            <t t-if="line.marked_at">
                                                <span t-esc="context_timestamp(line.marked_at).strftime('%H:%M:%S')"/>
                                            </t>
                                            <t t-else="">
                                                <span style="color: #9e9e9e;">—</span>
                                            </t>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #bdbdbd; font-size: 10px; color: #616161;">
                                            <span t-field="line.notes"/>
                                        </td>
                                    </tr>
                                    <t t-set="idx" t-value="idx + 1"/>
                                </t>
                            </tbody>
                        </table>

                        <!-- ======== PIED DE PAGE ======== -->
                        <table style="width: 100%; margin-top: 25px; border-collapse: collapse; font-size: 11px;">
                            <tr>
                                <td style="width: 50%; text-align: left; vertical-align: top;">
                                    <strong>Signature de l'enseignant :</strong>
                                    <div style="height: 45px; border-bottom: 1px dashed #9e9e9e; margin-top: 10px; width: 80%;"></div>
                                </td>
                                <td style="width: 50%; text-align: right; vertical-align: top;">
                                    <strong>Cachet / Visa Administration :</strong>
                                    <div style="height: 45px; border-bottom: 1px dashed #9e9e9e; margin-top: 10px; width: 80%; margin-left: auto;"></div>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top: 25px; border-top: 1px solid #c5cae9; padding-top: 8px; font-size: 9px; color: #757575; text-align: center;">
                            Document généré le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/> — Winners Academy Attendance System
                        </div>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
