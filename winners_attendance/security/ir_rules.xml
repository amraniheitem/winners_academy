<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_attendance_by_branch" model="ir.rule">
            <field name="name">Attendance: own branch only</field>
            <field name="model_id" ref="winners_attendance.model_winners_attendance"/>
            <field name="domain_force">[('branch_id', '=', user.branch_id.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_director')),
                (4, ref('winners_auth.winners_group_secretary')),
                (4, ref('winners_auth.winners_group_teacher')),
                (4, ref('winners_auth.winners_group_cashier')),
            ]"/>
        </record>
        <record id="rule_attendance_super_admin" model="ir.rule">
            <field name="name">Attendance: super admin sees all</field>
            <field name="model_id" ref="winners_attendance.model_winners_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_super_admin')),
            ]"/>
        </record>
    </data>
</odoo>
