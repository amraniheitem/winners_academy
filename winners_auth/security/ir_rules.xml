<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ======================== winners.branch ======================== -->
        <!-- Non-admin users only see their own branch -->
        <record id="rule_branch_by_user_branch" model="ir.rule">
            <field name="name">Branch: see own branch only</field>
            <field name="model_id" ref="winners_branch.model_winners_branch"/>
            <field name="domain_force">[('id', '=', user.branch_id.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_director')),
                (4, ref('winners_auth.winners_group_secretary')),
                (4, ref('winners_auth.winners_group_teacher')),
                (4, ref('winners_auth.winners_group_cashier')),
            ]"/>
        </record>
        <!-- Super Admin sees all branches -->
        <record id="rule_branch_super_admin" model="ir.rule">
            <field name="name">Branch: super admin sees all</field>
            <field name="model_id" ref="winners_branch.model_winners_branch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_super_admin')),
            ]"/>
        </record>

    </data>
</odoo>
