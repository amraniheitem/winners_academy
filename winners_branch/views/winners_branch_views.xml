<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_branch_tree" model="ir.ui.view">
            <field name="name">winners.branch.tree</field>
            <field name="model">winners.branch</field>
            <field name="arch" type="xml">
                <tree string="Branches">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_branch_form" model="ir.ui.view">
            <field name="name">winners.branch.form</field>
            <field name="model">winners.branch</field>
            <field name="arch" type="xml">
                <form string="Branche">
                    <sheet>
                        <group>
                            <group string="Informations générales">
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="is_active"/>
                            </group>
                            <group string="Adresse">
                                <field name="address"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_winners_branch" model="ir.actions.act_window">
            <field name="name">Branches</field>
            <field name="res_model">winners.branch</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle branche
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Menus (no winners_auth references here) -->
        <!-- ============================================================ -->
        <menuitem id="menu_winners_academy_root"
                  name="Winners Academy"
                  sequence="10"/>

        <menuitem id="menu_winners_personnes"
                  name="Personnes"
                  parent="menu_winners_academy_root"
                  sequence="15"/>

        <menuitem id="menu_winners_pointage"
                  name="Pointage"
                  parent="menu_winners_academy_root"
                  sequence="60"/>

        <menuitem id="menu_winners_branch"
                  name="Branches"
                  parent="menu_winners_academy_root"
                  action="action_winners_branch"
                  sequence="10"/>

    </data>
</odoo>
