<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- winners.student.enrollment — Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_student_enrollment_tree" model="ir.ui.view">
            <field name="name">winners.student.enrollment.tree</field>
            <field name="model">winners.student.enrollment</field>
            <field name="arch" type="xml">
                <tree string="Inscriptions" edit="false">
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <field name="subject"/>
                    <field name="sessions_remaining"/>
                    <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'alert'" decoration-danger="status == 'expired'" decoration-muted="status == 'suspended'"/>
                    <field name="enrollment_date"/>
                    <field name="branch_id"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- winners.student.enrollment — Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_student_enrollment_form" model="ir.ui.view">
            <field name="name">winners.student.enrollment.form</field>
            <field name="model">winners.student.enrollment</field>
            <field name="arch" type="xml">
                <form string="Inscription">
                    <header>
                        <button name="action_suspend" string="Suspendre" type="object" class="btn-secondary" invisible="status == 'suspended'"/>
                        <button name="action_reactivate" string="Réactiver" type="object" class="btn-primary" invisible="status != 'suspended'"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Informations de l'inscription">
                                <field name="student_id" readonly="id != False"/>
                                <field name="group_id" readonly="id != False"/>
                                <field name="enrollment_date"/>
                            </group>
                            <group string="État du compte">
                                <field name="sessions_remaining" readonly="1"/>
                                <field name="branch_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- winners.student.enrollment — Action -->
        <!-- ============================================================ -->
        <record id="action_winners_student_enrollment" model="ir.actions.act_window">
            <field name="name">Inscriptions</field>
            <field name="res_model">winners.student.enrollment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ============================================================ -->
        <!-- winners.student — Form View Inheritance -->
        <!-- ============================================================ -->
        <record id="view_winners_student_form_inherit_enrollment" model="ir.ui.view">
            <field name="name">winners.student.form.inherit.enrollment</field>
            <field name="model">winners.student</field>
            <field name="inherit_id" ref="winners_student.view_winners_student_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sessions_remaining']" position="replace">
                </xpath>
                <xpath expr="//field[@name='status']" position="replace">
                </xpath>
                <!-- Add new page for enrollments and schedule -->
                <xpath expr="//notebook" position="inside">
                    <page string="Inscriptions &amp; Emploi du Temps" name="enrollments_schedule">
                        <group>
                            <button name="action_print_schedule" string="Imprimer l'emploi du temps" type="object" class="btn-primary" icon="fa-print" style="margin-bottom: 10px;"/>
                        </group>
                        <separator string="Inscriptions aux groupes"/>
                        <field name="enrollment_ids">
                            <tree string="Inscriptions" editable="bottom">
                                <field name="group_id"/>
                                <field name="subject" readonly="1"/>
                                <field name="sessions_remaining" readonly="1"/>
                                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'alert'" decoration-danger="status == 'expired'" decoration-muted="status == 'suspended'"/>
                                <field name="enrollment_date"/>
                            </tree>
                        </field>
                        <separator string="Emploi du temps agrégé"/>
                        <field name="schedule_ids" readonly="1">
                            <tree string="Emploi du Temps">
                                <field name="day_of_week"/>
                                <field name="time_start" widget="float_time"/>
                                <field name="time_end" widget="float_time"/>
                                <field name="group_id"/>
                                <field name="teacher_id"/>
                                <field name="room_id"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- winners.group — Form View Inheritance -->
        <!-- ============================================================ -->
        <record id="view_winners_student_tree_inherit_enrollment" model="ir.ui.view">
            <field name="name">winners.student.tree.inherit.enrollment</field>
            <field name="model">winners.student</field>
            <field name="inherit_id" ref="winners_student.view_winners_student_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sessions_remaining']" position="replace"/>
            </field>
        </record>

        <record id="view_winners_group_form_inherit_enrollment" model="ir.ui.view">
            <field name="name">winners.group.form.inherit.enrollment</field>
            <field name="model">winners.group</field>
            <field name="inherit_id" ref="winners_group.view_winners_group_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='student_ids']" position="replace">
                    <field name="enrollment_ids">
                        <tree string="Élèves inscrits" editable="bottom">
                            <field name="student_id"/>
                            <field name="sessions_remaining" readonly="1"/>
                            <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'alert'" decoration-danger="status == 'expired'" decoration-muted="status == 'suspended'"/>
                            <field name="enrollment_date"/>
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
