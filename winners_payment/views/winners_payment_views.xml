<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_tree" model="ir.ui.view">
            <field name="name">winners.payment.tree</field>
            <field name="model">winners.payment</field>
            <field name="arch" type="xml">
                <tree string="Paiements">
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="sessions_count"/>
                    <field name="payment_mode"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_form" model="ir.ui.view">
            <field name="name">winners.payment.form</field>
            <field name="model">winners.payment</field>
            <field name="arch" type="xml">
                <form string="Paiement">
                    <header>
                        <button name="action_confirm"
                                string="Confirmer"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Informations du paiement">
                                <field name="student_id"/>
                                <field name="group_id" readonly="state == 'confirmed'"/>
                                <field name="session_price"/>
                                <field name="date"/>
                                <field name="amount"/>
                                <field name="sessions_count"/>
                                <field name="payment_mode"/>
                            </group>
                            <group string="Détails">
                                <field name="branch_id"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_winners_payment" model="ir.actions.act_window">
            <field name="name">Paiements</field>
            <field name="res_model">winners.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Enregistrer un nouveau paiement
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Menu -->
        <!-- ============================================================ -->
        <menuitem id="menu_winners_payment"
                  name="Paiements"
                  parent="winners_branch.menu_winners_academy_root"
                  action="action_winners_payment"
                  groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director,winners_auth.winners_group_secretary,winners_auth.winners_group_cashier"
                  sequence="60"/>

    </data>
</odoo>
