<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_tree" model="ir.ui.view">
            <field name="name">winners.payment.tree</field>
            <field name="model">winners.payment</field>
            <field name="arch" type="xml">
                <tree string="Paiements">
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <field name="amount"/>
                    <field name="sessions_count"/>
                    <field name="date"/>
                    <field name="payment_mode"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_form" model="ir.ui.view">
            <field name="name">winners.payment.form</field>
            <field name="model">winners.payment</field>
            <field name="arch" type="xml">
                <form string="Paiement">
                    <header>
                        <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state == 'confirmed'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Informations du paiement">
                                <field name="student_id"/>
                                <field name="group_id"/>
                                <field name="amount"/>
                                <field name="sessions_count"/>
                            </group>
                            <group string="Détails">
                                <field name="date"/>
                                <field name="payment_mode"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Search View -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_search" model="ir.ui.view">
            <field name="name">winners.payment.search</field>
            <field name="model">winners.payment</field>
            <field name="arch" type="xml">
                <search string="Rechercher paiements">
                    <field name="student_id"/>
                    <field name="group_id"/>
                    <field name="payment_mode"/>
                    <filter string="Espèces" name="cash" domain="[('payment_mode', '=', 'cash')]"/>
                    <filter string="Virement" name="transfer" domain="[('payment_mode', '=', 'transfer')]"/>
                    <group expand="0" string="Grouper par">
                        <filter string="Mode de paiement" name="group_mode" context="{'group_by': 'payment_mode'}"/>
                        <filter string="Étudiant" name="group_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Groupe" name="group_group" context="{'group_by': 'group_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_winners_payment" model="ir.actions.act_window">
            <field name="name">Paiements</field>
            <field name="res_model">winners.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_winners_payment_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Enregistrer un nouveau paiement
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Menu : Placé sous Finance -->
        <!-- ============================================================ -->
        <menuitem id="menu_winners_payment"
                  name="Paiements"
                  parent="winners_branch.menu_winners_finance"
                  action="action_winners_payment"
                  groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director,winners_auth.winners_group_secretary,winners_auth.winners_group_cashier"
                  sequence="10"/>

    </data>
</odoo>
