<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_ticket_80mm" model="report.paperformat">
            <field name="name">Ticket Thermique 80mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">200</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- ============================================================ -->
        <!-- ir.actions.report : Bon de Paiement PDF -->
        <!-- ============================================================ -->
        <record id="action_report_payment" model="ir.actions.report">
            <field name="name">Bon de Paiement</field>
            <field name="model">winners.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">winners_print.report_payment_document</field>
            <field name="report_file">winners_print.report_payment_document</field>
            <field name="print_report_name">'Bon_Paiement_%s' % object.student_id.name</field>
            <field name="binding_model_id" ref="winners_payment.model_winners_payment"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="winners_print.paperformat_ticket_80mm"/>
        </record>

        <!-- ============================================================ -->
        <!-- Bouton "Imprimer le bon" dans la form view de winners.payment -->
        <!-- Visible uniquement quand state == 'confirmed' -->
        <!-- ============================================================ -->
        <record id="view_winners_payment_form_inherit_pdf_print" model="ir.ui.view">
            <field name="name">winners.payment.form.inherit.pdf.print</field>
            <field name="model">winners.payment</field>
            <field name="inherit_id" ref="winners_payment.view_winners_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="%(action_report_payment)d"
                            string="📄 Imprimer le bon (PDF)"
                            type="action"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"
                            invisible="state != 'confirmed'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
