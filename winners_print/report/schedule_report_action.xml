<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- ir.actions.report : Emploi du Temps PDF -->
        <!-- ============================================================ -->
        <record id="action_report_student_schedule" model="ir.actions.report">
            <field name="name">Emploi du Temps Étudiant</field>
            <field name="model">winners.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">winners_print.report_student_schedule_document</field>
            <field name="report_file">winners_print.report_student_schedule_document</field>
            <field name="print_report_name">'Emploi_du_Temps_%s' % (object.name)</field>
            <field name="binding_model_id" ref="winners_student.model_winners_student"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

    </data>
</odoo>
