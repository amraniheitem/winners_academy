<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="view_winners_printer_config_form" model="ir.ui.view">
            <field name="name">winners.printer.config.form</field>
            <field name="model">winners.printer.config</field>
            <field name="arch" type="xml">
                <form string="Configuration Imprimante Thermique">
                    <header>
                        <button name="action_test_impression"
                                string="🖨️ Tester l'impression"
                                type="object"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Par Défaut" bg_color="text-bg-success" invisible="not is_default"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="ex: Imprimante Principale"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identifiants USB (XP80C)">
                                <field name="vendor_id"/>
                                <field name="product_id"/>
                                <field name="is_default"/>
                                <field name="active"/>
                            </group>
                            <group string="En-tête des tickets">
                                <field name="academy_name"/>
                                <field name="branch_name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_winners_printer_config_tree" model="ir.ui.view">
            <field name="name">winners.printer.config.tree</field>
            <field name="model">winners.printer.config</field>
            <field name="arch" type="xml">
                <tree string="Configurations Imprimantes">
                    <field name="name"/>
                    <field name="vendor_id"/>
                    <field name="product_id"/>
                    <field name="academy_name"/>
                    <field name="is_default"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Action Window -->
        <record id="action_winners_printer_config" model="ir.actions.act_window">
            <field name="name">Configuration Imprimante</field>
            <field name="res_model">winners.printer.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configurer une imprimante thermique USB (XP80C)
                </p>
            </field>
        </record>

    </data>
</odoo>
