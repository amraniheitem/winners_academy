<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default deduction rate per teacher absence: 1000 DA -->
        <record id="param_default_absence_deduction_rate" model="ir.config_parameter">
            <field name="key">winners_salary.default_absence_deduction_rate</field>
            <field name="value">1000.0</field>
        </record>

        <!-- Default overtime rate per hour: 500 DA -->
        <record id="param_default_overtime_rate" model="ir.config_parameter">
            <field name="key">winners_salary.default_overtime_rate</field>
            <field name="value">500.0</field>
        </record>
    </data>
</odoo>
