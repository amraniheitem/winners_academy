<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════ -->
        <!-- RECORD RULES — winners.salary          -->
        <!-- ══════════════════════════════════════ -->

        <!-- Super Admin: full access to ALL salary slips -->
        <record id="rule_salary_super_admin" model="ir.rule">
            <field name="name">Salary: Super Admin sees all</field>
            <field name="model_id" ref="winners_salary.model_winners_salary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_super_admin')),
            ]"/>
        </record>

        <!-- Director: only their own branch -->
        <record id="rule_salary_director" model="ir.rule">
            <field name="name">Salary: Director own branch only</field>
            <field name="model_id" ref="winners_salary.model_winners_salary"/>
            <field name="domain_force">[('branch_id', '=', user.branch_id.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_director')),
            ]"/>
        </record>

        <!-- Teacher: only their own salary slips -->
        <record id="rule_salary_teacher" model="ir.rule">
            <field name="name">Salary: Teacher own slips only</field>
            <field name="model_id" ref="winners_salary.model_winners_salary"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_teacher')),
            ]"/>
        </record>

        <!-- Secretary: read-only access, own branch only -->
        <record id="rule_salary_secretary" model="ir.rule">
            <field name="name">Salary: Secretary own branch only</field>
            <field name="model_id" ref="winners_salary.model_winners_salary"/>
            <field name="domain_force">[('branch_id', '=', user.branch_id.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_secretary')),
            ]"/>
        </record>

        <!-- Cashier: read-only access, own branch only -->
        <record id="rule_salary_cashier" model="ir.rule">
            <field name="name">Salary: Cashier own branch only</field>
            <field name="model_id" ref="winners_salary.model_winners_salary"/>
            <field name="domain_force">[('branch_id', '=', user.branch_id.id)]</field>
            <field name="groups" eval="[
                (4, ref('winners_auth.winners_group_cashier')),
            ]"/>
        </record>

    </data>
</odoo>
