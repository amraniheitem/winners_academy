<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_winners_teacher_earning_sheet_tree" model="ir.ui.view">
            <field name="name">winners.teacher.earning.sheet.tree</field>
            <field name="model">winners.teacher.earning.sheet</field>
            <field name="arch" type="xml">
                <tree string="Bordereaux de gains" decoration-success="state == 'treated'" decoration-warning="state == 'not_treated'">
                    <field name="name"/>
                    <field name="teacher_id"/>
                    <field name="group_id"/>
                    <field name="branch_id"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="total_present_count"/>
                    <field name="total_amount"/>
                    <field name="teacher_amount"/>
                    <field name="company_amount"/>
                    <field name="state" widget="badge" decoration-success="state == 'treated'" decoration-warning="state == 'not_treated'"/>
                </tree>
            </field>
        </record>

        <record id="view_winners_teacher_earning_sheet_form" model="ir.ui.view">
            <field name="name">winners.teacher.earning.sheet.form</field>
            <field name="model">winners.teacher.earning.sheet</field>
            <field name="arch" type="xml">
                <form string="Bordereau de gains">
                    <header>
                        <button name="action_mark_treated"
                                string="Marquer comme traite"
                                type="object"
                                class="oe_highlight"
                                invisible="state == 'treated'"
                                groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director"/>
                        <button name="action_reset_not_treated"
                                string="Rouvrir"
                                type="object"
                                invisible="state != 'treated'"
                                groups="winners_auth.winners_group_super_admin"/>
                        <field name="state" widget="statusbar" statusbar_visible="not_treated,treated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Contexte">
                                <field name="teacher_id" readonly="1"/>
                                <field name="group_id" readonly="1"/>
                                <field name="branch_id" readonly="1"/>
                                <field name="period_start" readonly="1"/>
                                <field name="period_end" readonly="1"/>
                            </group>
                            <group string="Snapshots">
                                <field name="commission_percentage" readonly="1"/>
                                <field name="session_price" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Montants">
                            <group>
                                <field name="total_present_count" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                            </group>
                            <group>
                                <field name="teacher_amount" readonly="1"/>
                                <field name="company_amount" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Seances du lot">
                                <field name="line_ids" readonly="1">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="sequence_in_batch"/>
                                        <field name="attendance_sheet_id"/>
                                        <field name="session_date"/>
                                        <field name="present_count"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Traitement" invisible="state != 'treated'">
                                <group>
                                    <field name="treated_by"/>
                                    <field name="treated_at"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_winners_teacher_earning_sheet_search" model="ir.ui.view">
            <field name="name">winners.teacher.earning.sheet.search</field>
            <field name="model">winners.teacher.earning.sheet</field>
            <field name="arch" type="xml">
                <search string="Bordereaux de gains">
                    <field name="teacher_id"/>
                    <field name="group_id"/>
                    <field name="branch_id"/>
                    <filter name="not_treated" string="Non traites" domain="[('state', '=', 'not_treated')]"/>
                    <filter name="treated" string="Traites" domain="[('state', '=', 'treated')]"/>
                    <separator/>
                    <group expand="0" string="Grouper par">
                        <filter name="group_teacher" string="Enseignant" context="{'group_by': 'teacher_id'}"/>
                        <filter name="group_group" string="Groupe" context="{'group_by': 'group_id'}"/>
                        <filter name="group_branch" string="Branche" context="{'group_by': 'branch_id'}"/>
                        <filter name="group_state" string="Etat" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_winners_teacher_earning_sheet" model="ir.actions.act_window">
            <field name="name">Bordereaux enseignants</field>
            <field name="res_model">winners.teacher.earning.sheet</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_winners_teacher_earning_sheet_search"/>
        </record>

        <record id="view_winners_group_form_salary_inherit" model="ir.ui.view">
    <field name="name">winners.group.form.salary.inherit</field>
    <field name="model">winners.group</field>
    <field name="inherit_id" ref="winners_group.view_winners_group_form"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
            <group string="Configuration Salaire Enseignant">
                <field name="currency_id" invisible="1"/>
                <field name="session_price"/>
                <field name="earning_cycle"/>
            </group>
        </xpath>
    </field>
</record>

        <record id="view_winners_teacher_form_salary_inherit" model="ir.ui.view">
            <field name="name">winners.teacher.form.salary.inherit</field>
            <field name="model">winners.teacher</field>
            <field name="inherit_id" ref="winners_teacher.view_winners_teacher_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='base_salary']" position="after">
                    <field name="commission_percentage"
                           groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director"/>
                </xpath>
            </field>
        </record>

        <record id="view_winners_attendance_sheet_form_salary_inherit" model="ir.ui.view">
            <field name="name">winners.attendance.sheet.form.salary.inherit</field>
            <field name="model">winners.attendance.sheet</field>
            <field name="inherit_id" ref="winners_attendance.view_winners_attendance_sheet_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='teacher_id']" position="after">
                    <field name="teacher_snapshot_id" readonly="1"/>
                    <field name="earning_processed" readonly="1"/>
                </xpath>
            </field>
        </record>

        <menuitem id="menu_winners_teacher_earning_sheet"
                  name="Bordereaux enseignants"
                  parent="winners_branch.menu_winners_academy_root"
                  action="action_winners_teacher_earning_sheet"
                  sequence="21"
                  groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director,winners_auth.winners_group_secretary,winners_auth.winners_group_teacher"/>
    </data>
</odoo>
