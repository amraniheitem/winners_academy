<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_schedule_tree" model="ir.ui.view">
            <field name="name">winners.schedule.tree</field>
            <field name="model">winners.schedule</field>
            <field name="arch" type="xml">
                <tree string="Emploi du temps">
                    <field name="group_id"/>
                    <field name="teacher_id"/>
                    <field name="room_id"/>
                    <field name="day_of_week"/>
                    <field name="time_start" widget="float_time"/>
                    <field name="time_end" widget="float_time"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_schedule_form" model="ir.ui.view">
            <field name="name">winners.schedule.form</field>
            <field name="model">winners.schedule</field>
            <field name="arch" type="xml">
                <form string="Créneau horaire">
                    <sheet>
                        <group>
                            <group string="Informations du créneau">
                                <field name="group_id"/>
                                <field name="teacher_id"/>
                                <field name="room_id"/>
                                <field name="branch_id"/>
                            </group>
                            <group string="Horaire">
                                <field name="day_of_week"/>
                                <field name="time_start" widget="float_time"/>
                                <field name="time_end" widget="float_time"/>
                                <field name="is_active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_winners_schedule" model="ir.actions.act_window">
            <field name="name">Emploi du temps</field>
            <field name="res_model">winners.schedule</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Ajouter un créneau horaire
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Menu -->
        <!-- ============================================================ -->
        <menuitem id="menu_winners_schedule"
                  name="Emploi du temps"
                  parent="winners_branch.menu_winners_academy_root"
                  action="action_winners_schedule"
                  groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director,winners_auth.winners_group_secretary,winners_auth.winners_group_teacher"
                  sequence="70"/>

    </data>
</odoo>
