<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_winners_teacher_tree" model="ir.ui.view">
            <field name="name">winners.teacher.tree</field>
            <field name="model">winners.teacher</field>
            <field name="arch" type="xml">
                <tree string="Enseignants">
                    <field name="name"/>
                    <field name="specialty"/>
                    <field name="phone"/>
                    <field name="base_salary"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_winners_teacher_form" model="ir.ui.view">
            <field name="name">winners.teacher.form</field>
            <field name="model">winners.teacher</field>
            <field name="arch" type="xml">
                <form string="Enseignant">
                    <header>
                        <button name="action_create_user"
                                string="Créer un compte utilisateur"
                                type="object"
                                class="oe_highlight"
                                invisible="user_id != False"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Informations personnelles">
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="specialty"/>
                                <field name="hire_date"/>
                                <field name="base_salary"/>
                            </group>
                            <group string="Affectation">
                                <field name="branch_id"/>
                                <field name="user_id"/>
                                <field name="is_active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_winners_teacher" model="ir.actions.act_window">
            <field name="name">Enseignants</field>
            <field name="res_model">winners.teacher</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Ajouter un nouvel enseignant
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Menu -->
        <!-- ============================================================ -->
        <menuitem id="menu_winners_teacher"
                  name="Enseignants"
                  parent="winners_branch.menu_winners_academy_root"
                  action="action_winners_teacher"
                  groups="winners_auth.winners_group_super_admin,winners_auth.winners_group_director,winners_auth.winners_group_secretary"
                  sequence="20"/>

    </data>
</odoo>
